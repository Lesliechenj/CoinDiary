<?xml version="1.0" encoding="utf-8"?>
<!--
  应用图标前景：一枚纸白色的硬币 + 中央的 ¥。

  为什么是硬币？
  「碎银集」—— 一枚一枚小钱攒起来，硬币是最短的那句话。

  为什么只有黑白两色？
  App 整体的语言是「收银小票」：纸、墨、细线。
  图标如果加了渐变或彩色装饰，就会和里面的界面脱节。
  深墨底 + 纸白线，在任何壁纸上都立得住，缩到 40dp 也不糊。
  实测过的取舍：加绿线／绿 ¥ 在小尺寸下会变成一道灰痕，所以全部去掉。

  安全区：自适应图标只有中间 72dp（18~90）不会被裁，
  硬币直径 52、圆心 (54,54)，正好落在安全区正中。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 硬币外圈：圆心 (54,54)，半径 26 -->
    <path
        android:strokeColor="#FBFAF6"
        android:strokeWidth="5.5"
        android:pathData="M28,54 A26,26 0 0,1 80,54 A26,26 0 0,1 28,54" />

    <!-- ¥ 的两撇：一笔画成的 V -->
    <path
        android:strokeColor="#FBFAF6"
        android:strokeWidth="4.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M44,41 L54,54 L64,41" />

    <!-- ¥ 的竖 -->
    <path
        android:strokeColor="#FBFAF6"
        android:strokeWidth="4.2"
        android:strokeLineCap="round"
        android:pathData="M54,54 L54,68" />

    <!-- ¥ 的两横 -->
    <path
        android:strokeColor="#FBFAF6"
        android:strokeWidth="4.2"
        android:strokeLineCap="round"
        android:pathData="M45,57 L63,57" />
    <path
        android:strokeColor="#FBFAF6"
        android:strokeWidth="4.2"
        android:strokeLineCap="round"
        android:pathData="M45,62 L63,62" />

</vector>
